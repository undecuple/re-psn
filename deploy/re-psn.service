# systemd unit for re-psn. Copy the binary to /usr/local/bin/re-psn and this file to /etc/systemd/system/re-psn.service,
# put your settings in /etc/re-psn/re-psn.env (start from re-psn.env.example next to this file), then:
#   systemctl daemon-reload && systemctl enable --now re-psn
# Coming from psnr.service: systemctl disable --now psnr first (both units use the same ports). Your old
# /etc/psnr/psnr.env is still read: it is loaded first and /etc/re-psn/re-psn.env second, so a value in the new file wins.
# Both files are optional. The state directory keeps its old name, /var/lib/psnr, so an existing log file stays put.
# If you change a port, change it in your firewall too.
[Unit]
Description=re-psn matchmaking server
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/re-psn
EnvironmentFile=-/etc/psnr/psnr.env
EnvironmentFile=-/etc/re-psn/re-psn.env
Restart=on-failure
RestartSec=2
DynamicUser=yes
# a log file, if you set RE_PSN_LOG_FILE, belongs under /var/lib/psnr (the name is kept for existing installs)
StateDirectory=psnr
# open files: the default -max-conns is 4096 and a relayed stream holds two sockets, so keep this above twice the value you set
LimitNOFILE=16384
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
